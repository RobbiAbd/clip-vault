{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip-Vault",
  "version": "0.3.0",
  "identifier": "com.clipvault.app",
  "build": {
    "beforeDevCommand": "",
    "frontendDist": "ui",
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RobbiAbd/clip-vault/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMTQyODA5QUU2QkY1MUUKUldRZTlXdXVDU2dVQUM2eWZkaGVUclVUWjljWmw0dG14WExDeWhaVUVKdDN5ZmMwVk9XMjVaYWgK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clip-Vault",
        "width": 900,
        "height": 700,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
